  "scenes": [
    {
      "id": "hook",
      "type": "title",
      "narration": "How long does it take money to double? There is a shortcut lenders have used for over five hundred years, and you can do it in your head.",
      "props": {
        "headline": "How fast money doubles",
        "kicker": "Compound interest"
      }
    },
    {
      "id": "venice",
      "type": "title",
      "year": 1494,
      "sourceFactId": "f-pacioli",
      "narration": "It shows up in a book printed in Venice in fourteen ninety-four. The mathematician Luca Pacioli set it down as a rule of thumb for merchants lending at interest.",
      "props": {
        "headline": "A rule from Venice",
        "kicker": "Luca Pacioli"
      }
    },
    {
      "id": "rule",
      "type": "kinetic-text",
      "narration": "Divide seventy two by the yearly interest rate. The answer is roughly how many years the money takes to double.",
      "props": {
        "lines": [
          "Divide",
          "seventy two",
          "by the rate"
        ]
      },
      "cues": [
        {
          "atWord": "Divide",
          "do": "emphasize",
          "text": "Divide"
        },
        {
          "atWord": "rate",
          "do": "emphasize",
          "text": "rate"
        }
      ]
    },
    {
      "id": "growth",
      "type": "line-chart",
      "ground": "parchment",
      "narration": "At eight percent, seventy two over eight is nine. So a thousand dollars becomes about two thousand in nine years, four thousand in eighteen, and eight thousand in twenty seven.",
      "props": {
        "title": "$1,000 at 8% a year",
        "xFormat": "number",
        "prefix": "$",
        "decimals": 0,
        "tone": "positive",
        "factId": "f-growth",
        "points": [
          {
            "x": 0,
            "y": 1000
          },
          {
            "x": 9,
            "y": 1999
          },
          {
            "x": 18,
            "y": 3996
          },
          {
            "x": 27,
            "y": 7988
          }
        ]
      }
    },
    {
      "id": "exact",
      "type": "compare",
      "narration": "Is it accurate? At eight percent the rule says nine years. The exact answer is nine point zero zero six. The gap is tiny.",
      "props": {
        "title": "Years to double at 8%",
        "suffix": " yrs",
        "decimals": 3,
        "left": {
          "label": "Rule of 72",
          "value": 9,
          "factId": "f-8rule"
        },
        "right": {
          "label": "Exact math",
          "value": 9.006,
          "factId": "f-8exact"
        }
      }
    },
    {
      "id": "caveat",
      "type": "kinetic-text",
      "narration": "It is an estimate, not a promise. Real returns move from year to year, and the rule leaves out taxes and fees.",
      "props": {
        "lines": [
          "An estimate",
          "not a promise"
        ]
      },
      "cues": [
        {
          "atWord": "estimate",
          "do": "emphasize",
          "text": "estimate"
        },
        {
          "atWord": "promise",
          "do": "emphasize",
          "text": "promise"
        }
      ]
    },
    {
      "id": "close",
      "type": "title",
      "narration": "Seventy two over the rate. Five centuries old, and still the quickest way to see what time does to money.",
      "props": {
        "headline": "Divide, then double",
        "kicker": "Rule of seventy two"
      }
    }
  ]
