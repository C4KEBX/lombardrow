        "name": "C. G. Lewin, \"The emergence of compound interest\", British Actuarial Journal 24 (2019)",
        "stamp": "British Actuarial Journal, 2019",
        "url": "https://www.cambridge.org/core/journals/british-actuarial-journal/article/emergence-of-compound-interest/799CB1D40CDD46F3010767BFC60F24DB",
        "tier": "scholarly"
      },
      "corroboration": [
        {
          "name": "Wikipedia: Rule of 72",
          "url": "https://en.wikipedia.org/wiki/Rule_of_72",
          "tier": "secondary"
        }
      ]
    },
