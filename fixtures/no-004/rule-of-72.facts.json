      "id": "f-pacioli",
      "claim": "Luca Pacioli's Summa de arithmetica, printed in Venice in 1494, gives the rule of 72 for estimating how long an investment takes to double.",
      "source": { "name": "Wikipedia: Rule of 72", "stamp": "Pacioli, Summa de arithmetica (1494)", "url": "https://en.wikipedia.org/wiki/Rule_of_72" }
    },
    {
      "id": "f-growth",
      "claim": "$1,000 compounding at 8% a year, at 0, 9, 18 and 27 years, rounded to the dollar: 1,000, 1,999, 3,996, 7,988.",
      "dataset": [ { "x": 0, "y": 1000 }, { "x": 9, "y": 1999 }, { "x": 18, "y": 3996 }, { "x": 27, "y": 7988 } ],
      "source": { "name": "SEC, Investor.gov compound interest calculator", "stamp": "SEC, Investor.gov", "url": "https://www.investor.gov/financial-tools-calculators/calculators/compound-interest-calculator" }
    },
    {
      "id": "f-8rule",
      "claim": "At 8% a year the rule of 72 gives 72 / 8 = 9 years to double.",
      "value": 9,
      "source": { "name": "SEC, Investor.gov", "url": "https://www.investor.gov/additional-resources/information/youth/teachers-classroom-resources/what-compound-interest" }
    },
    {
      "id": "f-8exact",
      "claim": "At 8% a year the exact doubling time is ln 2 / ln 1.08 = 9.006 years.",
