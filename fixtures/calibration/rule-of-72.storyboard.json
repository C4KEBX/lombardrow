        }
      ]
    },
    {
      "id": "close",
      "type": "title",
      "narration": "Seventy two over the rate. A simple way to picture how time and growth work together, one year at a time.",
      "props": {
        "headline": "Divide, then double",
        "kicker": "RULE OF SEVENTY TWO"
      },
