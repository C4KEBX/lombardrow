    {
      "id": "peak",
      "type": "big-number",
      "narration": "In December twenty twenty one, prices stood seven percent above where they were a year earlier. That was the fastest yearly pace in this whole stretch of years.",
      "props": {
        "value": 7,
        "suffix": "%",
        "decimals": 1,
