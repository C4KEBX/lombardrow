      "sourceFactId": "f-charter",
      "speaks": [
        "f-charter"
      ],
      "narration": "Amsterdam, August 1602. For one month, a new company let anyone in the Dutch Republic buy a piece of it.",
      "props": {
        "headline": "The first shares anyone could buy",
        "kicker": "Amsterdam, 1602"
      }
    },
    {
      "id": "charter",
      "type": "kinetic-text",
      "ground": "ink",
      "speaks": [
        "f-charter"
      ],
      "sourceFactId": "f-charter",
      "narration": "It was the Dutch East India Company. Its charter ran 21 years, and your money stayed in for at least ten.",
      "props": {
        "lines": [
          "Built",
          "to last"
        ]
      },
      "cues": [
        {
