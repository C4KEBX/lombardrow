      "speaks": [
        "f-8rule"
      ]
    },
    {
      "id": "growth",
      "type": "line-chart",
      "ground": "parchment",
      "narration": "Pacioli's own example was eight percent: seventy two over eight is nine. A thousand dollars becomes about two thousand in nine years, four thousand in eighteen, and eight thousand in twenty seven.",
      "props": {
        "title": "$1,000 at 8% a year",
        "xFormat": "number",
        "prefix": "$",
        "decimals": 0,
        "tone": "positive",
        "factId": "f-growth",
