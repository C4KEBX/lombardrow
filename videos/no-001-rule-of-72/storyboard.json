          "zoom": 1.8
        }
      }
    },
    {
      "id": "rule",
      "type": "kinetic-text",
      "narration": "Divide seventy two by the yearly interest rate. The answer is roughly how many years the money takes to double.",
      "props": {
        "lines": [
          "Divide",
          "seventy two",
          "by the rate"
        ]
      },
      "cues": [
        {
          "atWord": "Divide",
