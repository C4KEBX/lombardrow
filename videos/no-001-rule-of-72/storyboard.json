        "f-summa"
      ]
    },
    {
      "id": "exact",
      "type": "compare",
      "narration": "Is it accurate? The rule says nine years. The exact answer is nine point zero zero six.",
      "props": {
        "title": "Years to double at 8%",
        "suffix": " yrs",
        "decimals": 3,
        "left": {
          "label": "Rule of 72",
          "value": 9,
