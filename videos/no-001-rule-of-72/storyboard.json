    {
      "id": "hook",
      "type": "title",
      "narration": "How long does it take money to double? Lenders have used a shortcut for over five hundred years, and you can do it in your head.",
      "props": {
        "headline": "How fast money doubles",
        "kicker": "Compound interest"
      },
      "speaks": [
        "f-summa"
      ]
    },
    {
      "id": "venice",
      "type": "title",
      "year": 1494,
      "sourceFactId": "f-summa",
      "narration": "It shows up in a book printed in Venice in 1494.",
      "props": {
        "headline": "A rule from Venice",
        "kicker": "Luca Pacioli"
      }
    },
    {
      "id": "summa",
      "type": "archival",
      "sourceFactId": "f-summa",
      "narration": "Luca Pacioli set it down as a rule of thumb for merchants lending at interest.",
      "props": {
        "title": "Pacioli's Summa, folio 181",
        "assetId": "summa-fol-181",
        "from": {
          "x": 0.5,
          "y": 0.4,
          "zoom": 1
        },
        "to": {
